============================================
ADICIONE NO SEU .ENV AS VARIAVEIS DO SEU LDAP
============================================

LDAP_ENABLED=true

LDAP_HOST=DC01.exemplo.local
LDAP_PORT=636

LDAP_BASE_DN=DC=ad,DC=exemplo,DC=local

LDAP_BIND_DN=svc_chatwoot_ldap@exemplo.local
LDAP_BIND_PASSWORD=SUA SENHA DA CONTA DE SERVIÇO

LDAP_LOGIN_ATTRIBUTE=mail
LDAP_TIMEOUT=5

LDAP_ACCOUNT_ID=1

================== CRIE GRUPOS DE ACESSO PARA O CHATWOOT=============================

LDAP_USERS_GROUP=CN=GG-Chatwoot-Users,OU=Groups,OU=EXEMPLO,DC=ad,DC=exemplo,DC=local

LDAP_ADMINS_GROUP=CN=GG-Chatwoot-Admins,OU=Groups,OU=EXEMPLO,DC=ad,DC=exemplo,DC=local
